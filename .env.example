# These point at the SAME Supabase project as the habit tracker — Becoming
# Self doesn't have its own project (account is capped at 2 free projects,
# both already in use). All of this project's tables live in their own
# `becoming_self` Postgres schema in that project, isolated from the habit
# tracker's tables by namespace and by grants — see
# supabase/migrations/0001_fitness_dashboard.sql. Use the SAME URL/anon key
# the habit tracker uses; nothing else changes.
#
# Copy to .env.local for local development (gitignored — never commit real
# keys). In Vercel, set these as Project → Settings → Environment Variables
# for both Production and Preview.
#
# Both are the PUBLIC anon key pair — safe to expose in the browser bundle,
# access is restricted by Postgres Row Level Security (public SELECT only;
# see supabase/migrations/0001_fitness_dashboard.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Ingestion only — NEVER prefix with VITE_, NEVER put in Vercel ---
# These are used only by scripts/sync-garmin.mjs, run by the scheduled
# Claude Code Routine (or manually). Same project as above — the
# service_role key bypasses Row Level Security AND schema isolation, so it
# must only ever live in this ingestion environment, never anywhere the
# habit tracker's code or the browser could reach it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: IANA timezone used to resolve each activity's local calendar
# date from its UTC start time (see scripts/lib/util.js). Defaults to
# Europe/Berlin.
RUNNER_TIMEZONE=Europe/Berlin
