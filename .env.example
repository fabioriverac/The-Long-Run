# Copy to .env.local for local development (gitignored — never commit real
# keys). In Vercel, set these as Project → Settings → Environment Variables
# for both Production and Preview.
#
# Both are the PUBLIC anon key pair — safe to expose in the browser bundle,
# access is restricted by Postgres Row Level Security (public SELECT only;
# see supabase/migrations/0001_fitness_dashboard.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Ingestion only — NEVER prefix with VITE_, NEVER put in Vercel ---
# These are used only by scripts/sync-garmin.mjs, run by the scheduled
# Claude Code Routine (or manually). The service_role key bypasses Row
# Level Security, so it must only ever live in that ingestion environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: IANA timezone used to resolve each activity's local calendar
# date from its UTC start time (see scripts/lib/util.js). Defaults to
# Europe/Berlin.
RUNNER_TIMEZONE=Europe/Berlin
